OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# 在 AnythingLLM 管理后台创建 API Key 后填写
ANYTHINGLLM_API_KEY=

# kb-web 对外端口（80 常被占用，默认 8081）
KB_WEB_PORT=8081

# kb-web 对外完整 URL，写进结构化 Markdown，让 AnythingLLM 引用可跳转。
# 改为部署机的实际域名/IP，如 http://10.0.0.5:8081
KB_WEB_PUBLIC_URL=http://localhost:8081

# 开发环境兜底：AnythingLLM 不可用时允许 kb-web 使用本地 users 表密码登录。
# 生产交付前建议改为 0。
KB_WEB_ALLOW_LOCAL_AUTH=1

# 可选：宿主机直接 `python -m kb.cli ...` 时使用 http://localhost:8301，
# 留空则容器内执行用 docker 网络的 anythingllm:3001。
# ANYTHINGLLM_BASE_URL=http://localhost:8301
