# ========== 智能知识库环境变量 ==========

# 管理员密码（建议修改）
ADMIN_PASSWORD=kb-admin-2025
JWT_SECRET=kb-final-secret-20250512

# ========== 模型配置（三档可选）==========
# lite:        qwen2.5:1.5b   → 8GB 内存，CPU可用
# standard:    qwen2.5:7b     → 16GB 内存（推荐）
# performance: qwen2.5:14b    → 32GB 内存
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# Ollama 超时设置（秒）
OLLAMA_TIMEOUT=300

# ========== 路径（Docker 容器内）==========
DOCUMENTS_DIR=./volumes/documents
